+void CACHE::record_prefetch_event(bool roi_origin, uint64_t cache_stats::* roi_counter, uint64_t cache_stats::* warmup_counter)
+{
+  if (roi_origin)
+    ++(sim_stats.*roi_counter);
+  else if (!warmup)
+    ++(sim_stats.*warmup_counter);
+}
+
+std::size_t CACHE::count_pending_prefetch_requests(bool roi_origin) const
+{
+  auto matches_origin = [roi_origin](const auto& entry) {
+    return entry.type == access_type::PREFETCH && entry.prefetch_created_in_roi == roi_origin;
+  };
+  auto count_in = [&matches_origin](const auto& queue) { return static_cast<std::size_t>(std::count_if(std::begin(queue), std::end(queue), matches_origin)); };
+
+  auto pending = count_in(internal_PQ) + count_in(inflight_tag_check) + count_in(translation_stash);
+  for (const auto* upper : upper_levels)
+    pending += count_in(upper->RQ) + count_in(upper->PQ);
+  return pending;
+}
+
+std::size_t CACHE::count_warmup_prefetch_transactions() const
+{
+  auto is_warmup_prefetch = [](const auto& entry) { return entry.type == access_type::PREFETCH && !entry.prefetch_created_in_roi; };
+  auto is_warmup_prefetch_block = [](const auto& entry) { return entry.valid && entry.prefetch && !entry.prefetch_created_in_roi; };
+
+  return static_cast<std::size_t>(std::count_if(std::begin(MSHR), std::end(MSHR), is_warmup_prefetch)) +
+         static_cast<std::size_t>(std::count_if(std::begin(inflight_fills), std::end(inflight_fills), is_warmup_prefetch)) +
+         static_cast<std::size_t>(std::count_if(std::begin(block), std::end(block), is_warmup_prefetch_block));
+}
